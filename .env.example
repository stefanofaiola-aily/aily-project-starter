# Set tenant, environment, region and AWS profile explicitly before cloud access.
AILY_PREFIX=aily
AILY_TENANT=
AILY_ENV=
AILY_CLOUD_PROVIDER=aws
AWS_REGION=
AWS_PROFILE=

# Optional DAL shared database secret override, only when your team provides one.
# DAL_SHARED_DB_CREDENTIALS_PATH=

# uv does NOT read this file during sync. Configure index authentication in your
# shell or uv credential store; see README.md. Never put credentials in Git.
