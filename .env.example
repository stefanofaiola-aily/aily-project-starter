# Set tenant, environment, region and AWS profile explicitly before cloud access.
AILY_PREFIX=aily
AILY_TENANT=
AILY_ENV=
AILY_CLOUD_PROVIDER=aws
AWS_REGION=
AWS_PROFILE=
# Optional separate AWS profile for FMI shared scanner credentials.
# If blank, FMI uses AWS_PROFILE for both connections.
FMI_SHARED_AWS_PROFILE=
# Managed spreadsheet runtime, needed only for Excel export.
# FMI_NODE=
# FMI_NODE_MODULES=
# Optional notebook locations; defaults are FMI/data and repository outputs/fmi.
# FMI_DATA_DIR=
# FMI_OUTPUT_DIR=
# Separate dossier workflow; never inherits FMI_OUTPUT_DIR.
# FMI_DOSSIER_INPUTS_PATH=
# FMI_DOSSIER_DATA_DIR=
# FMI_DOSSIER_OUTPUT_DIR=

# Optional DAL shared database secret override, only when your team provides one.
# DAL_SHARED_DB_CREDENTIALS_PATH=

# uv does NOT read this file during sync. Configure index authentication in your
# shell or uv credential store; see README.md. Never put credentials in Git.
