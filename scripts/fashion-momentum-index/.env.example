# Optional convenience only. Shell launch variables work without this file.
# AWS credentials and region can come from the selected ~/.aws/config profile.
AILY_PREFIX=aily
AILY_TENANT=
AILY_ENV=
AILY_CLOUD_PROVIDER=aws
AWS_REGION=
AWS_PROFILE=
# Optional: defaults to rds-analytics. Set only for a confirmed custom route.
FMI_LIGHT_DB_TYPE=
# Optional override. Standard DAL resolves the read-only Light secret automatically.
FMI_LIGHT_DB_CREDENTIALS_PATH=
# Confirm the retained shared/prod connection; optional approved override.
# DAL_SHARED_DB_CREDENTIALS_PATH=
